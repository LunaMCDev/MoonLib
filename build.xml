<?xml version="1.0" encoding="UTF-8"?>
<!--
  Repository tasks. IntelliJ: View > Tool Windows > Ant > + > pick this file, then double-click a target.

    set-version     asks for the new version and changes it everywhere in this repository (pom.xml
                    and every install snippet in the README and docs)
    check-version   fails if anything disagrees with pom.xml (CI runs this too)

  The library itself is built with Maven (mvn clean install); MoonLib.VERSION is written into the jar
  from pom.xml, so it never needs editing. MoonLib-Example and MoonLib-Template have their own build.xml.
-->
<project name="moonlib" default="check-version" basedir=".">

    <target name="set-version" description="Change MoonLib's version everywhere (asks for it)">
        <input message="New MoonLib version (for example 1.3.0-beta or 1.3.0):" addproperty="new.version"/>
        <java sourcefile="tools/SetVersion.java" fork="true" failonerror="true" dir="${basedir}">
            <arg value="${new.version}"/>
        </java>
    </target>

    <target name="check-version" description="Check every place that shows the version agrees with pom.xml">
        <java sourcefile="tools/SetVersion.java" fork="true" failonerror="true" dir="${basedir}">
            <arg value="--check"/>
        </java>
    </target>
</project>
