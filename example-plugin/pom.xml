<?xml version="1.0" encoding="UTF-8"?>
<!--
  A complete example of a plugin that shades MoonLib.

  1. Install MoonLib locally first:   (in the MoonLib folder)  mvn clean install
  2. Build this plugin:                (in this folder)         mvn clean package
  3. Drop target/ExamplePlugin-1.0.0.jar into your server's plugins folder.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.example</groupId>
    <artifactId>example-plugin</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>ExamplePlugin</name>

    <properties>
        <maven.compiler.release>8</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <moonlib.version>1.2.0</moonlib.version>
    </properties>

    <repositories>
        <repository>
            <id>spigotmc-repo</id>
            <url>https://hub.spigotmc.org/nexus/content/repositories/snapshots/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>org.spigotmc</groupId>
            <artifactId>spigot-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>

        <!-- compile scope: this gets shaded into the plugin jar -->
        <dependency>
            <groupId>dev.lunamc</groupId>
            <artifactId>moonlib</artifactId>
            <version>${moonlib.version}</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <!-- replaces ${project.version} in plugin.yml -->
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <relocations>
                                <!--
                                  Recommended. Relocating gives this plugin its own private copy of
                                  MoonLib. Without it the plugin still works: it shares one copy with
                                  any other plugin that shades MoonLib unrelocated (see docs/shading.md).
                                -->
                                <relocation>
                                    <pattern>dev.lunamc.moonlib</pattern>
                                    <shadedPattern>com.example.exampleplugin.libs.moonlib</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
