<component name="ProjectRunConfigurationManager">
  <!--
    Builds the plugin into run/plugins (Maven profile "dev") and starts the local Paper server.
    Start it with DEBUG (Shift+F9), not Run: hot-swapping only works under the debugger.
    Set the JRE below (Edit Configurations... > JRE) to a JetBrains Runtime so you can also add
    methods and fields without restarting. See README.md.
  -->
  <configuration default="false" name="Dev Server" type="JarApplication">
    <option name="JAR_PATH" value="$PROJECT_DIR$/run/server.jar" />
    <option name="VM_PARAMETERS" value="-Xms1G -Xmx2G -XX:+IgnoreUnrecognizedVMOptions -XX:+AllowEnhancedClassRedefinition -Ddisable.watchdog=true -Dmoonlib.dev=true -Dmoonlib.dev.classes=$PROJECT_DIR$/target/classes" />
    <option name="PROGRAM_PARAMETERS" value="nogui" />
    <option name="WORKING_DIRECTORY" value="$PROJECT_DIR$/run" />
    <option name="ALTERNATIVE_JRE_PATH_ENABLED" value="false" />
    <option name="ALTERNATIVE_JRE_PATH" value="" />
    <method v="2">
      <option name="Maven.BeforeRunTask" enabled="true" file="$PROJECT_DIR$/pom.xml" goal="package -Pdev -DskipTests" />
    </method>
  </configuration>
</component>
